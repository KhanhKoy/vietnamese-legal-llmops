# ==============================================================================
# ⚖️ CONFIGURATION FILE - CHATBOT RAG LUẬT PHÁP VIỆT NAM
# ==============================================================================

# ------------------------------------------------------------------------------
# 📁 1. CẤU HÌNH DỮ LIỆU CỤC BỘ & CHUNKING (TUẦN 1 - TUẦN 3)
# ------------------------------------------------------------------------------
# Đường dẫn thư mục chứa các file .txt/.pdf luật demo của bạn
LOCAL_DEMO_PATH=D:/Law-Chatbot/data_demo

# Để trống tên để hệ thống tự nhận biết và ưu tiên đọc dữ liệu từ thư mục local ở trên
HF_DATASET_NAME=NguyenKH/clean_legal_knowledge

# Cấu hình cắt nhỏ văn bản luật hành chính (tính bằng số ký tự)
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200


# ------------------------------------------------------------------------------
# 🤖 2. CẤU HÌNH LOCAL EMBEDDING & TRUY VẤN
# ------------------------------------------------------------------------------
# Mô hình mã nhúng tiếng Việt của bạn
EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding
EMBEDDING_BATCH_SIZE=32

# Chọn thiết bị chạy mô hình local: "cpu" hoặc "cuda" (nếu máy bạn có card đồ họa Nvidia)
DEVICE=cpu

# Số lượng đoạn văn bản luật liên quan nhất muốn lôi ra để làm ngữ cảnh trả lời
TOP_K=5


# ------------------------------------------------------------------------------
# ♊ 3. CẤU HÌNH GOOGLE GEMINI API (GENERATOR - TUẦN 5 CHẠY DEMO)
# ------------------------------------------------------------------------------
# ⚠️ BẮT BUỘC: Bạn dán mã API Key lấy từ Google AI Studio vào đây để Chatbot hoạt động
GEMINI_API_KEY=Thay_Mã_Gemini_API_Key_Của_Bạn_Vào_Đây

# Phiên bản mô hình tối ưu hàng đầu cho hệ thống RAG hiện nay
GEMINI_MODEL_NAME=gemini-2.5-flash


# ------------------------------------------------------------------------------
# 💾 4. CẤU HÌNH DATABASE VECTOR (LOCAL FAISS VS AWS RDS CLOUD - TUẦN 4 & 6)
# ------------------------------------------------------------------------------
# CHẾ ĐỘ CHẠY HỆ THỐNG: 
# - Đặt "false" để chạy offline bằng FAISS + SQLite trên máy tính cá nhân
# - Đặt "true" khi deploy lên AWS để chạy bằng cơ sở dữ liệu Amazon RDS PostgreSQL
USE_PGVECTOR=true

# Các thông số kết nối Database (Dùng khi đặt USE_PGVECTOR=true)
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your_secure_password_here


# ------------------------------------------------------------------------------
# ☁️ 5. CẤU HÌNH DỊCH VỤ ĐÁM MÂY AWS (SAU KHI DEPLOY LÊN PRODUCTION - TUẦN 6 - 7)
# ------------------------------------------------------------------------------
# Quyền bảo mật kết nối dịch vụ AWS từ máy ảo (DynamoDB, CloudWatch)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=us-east-1

# Cấu hình nạp dữ liệu từ xa (Dùng cho AWS Lambda bám sát sơ đồ luồng Xanh Lá)
USE_S3=false
VECTOR_S3_BUCKET=your-legal-docs-s3-bucket-name
VECTOR_S3_PREFIX=data_demo/

# Bảng Amazon DynamoDB lưu lịch sử hội thoại của người dùng
DYNAMODB_TABLE_NAME=LegalChatbotHistory