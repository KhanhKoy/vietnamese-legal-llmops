# ==============================================================================
# Vietnamese Legal Chatbot - environment template
# Copy this file to .env and fill in real values locally.
# NEVER put real passwords, access keys or API keys in this tracked file.
# ==============================================================================

# Dataset and chunking
HF_DATASET_NAME=NguyenKH/core_legal_knowledge
LOCAL_DEMO_PATH=D:/path/to/data_demo
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# Local embedding
EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding
EMBEDDING_BATCH_SIZE=32
DEVICE=cpu
TOP_K=5

# LLM: gemini or bedrock
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.5-flash
BEDROCK_LLM_MODEL_ID=

# Embedding provider
USE_BEDROCK_EMBEDDING=false
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1

# PostgreSQL / pgvector
USE_PGVECTOR=true
PGHOST=replace_with_rds_endpoint
PGPORT=5432
PGDATABASE=postgres
PGUSER=replace_with_database_user
PGPASSWORD=replace_with_database_password
PGSSLMODE=require

# AWS SDK. On AWS, prefer IAM roles and leave access keys unset.
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=45

# S3 ingestion
USE_S3=false
VECTOR_S3_BUCKET=replace_with_bucket_name
VECTOR_S3_PREFIX=data_demo/
LEGAL_DOCUMENTS_BUCKET=replace_with_legal_documents_bucket
UPLOAD_URL_EXPIRY_SECONDS=900
MAX_UPLOAD_BYTES=52428800
INGESTION_EMBED_BATCH_SIZE=32

# Question answering performance
USE_RERANKER=false
ENABLE_QUERY_REWRITE=false
RETRIEVAL_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=45
PG_CONNECT_TIMEOUT_SECONDS=10
PG_QUERY_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_SECONDS=10
INDEX_COMMIT_INTERVAL=1000

# HNSW build - size these from actual RDS RAM/vCPU
HNSW_INDEX_NAME=idx_legal_chunks_embedding_hnsw
HNSW_MAINTENANCE_WORK_MEM=1GB
HNSW_PARALLEL_WORKERS=2
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_CREATE_CONCURRENTLY=false

# Cognito / API
AUTH_DISABLED=false
ENABLE_API_DOCS=false
CORS_ALLOWED_ORIGINS=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# DynamoDB chat history
DYNAMODB_CHAT_TABLE=LegalChatbotHistory
DYNAMODB_USER_INDEX=gsi_user_updated
DYNAMODB_ADMIN_INDEX=gsi_admin_date
CHAT_HISTORY_TTL_DAYS=180
ENABLE_CHAT_HISTORY=false

# Chainlit local-only login (do not use for production)
CHAINLIT_DEV_USERNAME=
CHAINLIT_DEV_PASSWORD=
# Required only when the two local login variables above are set.
CHAINLIT_AUTH_SECRET=
